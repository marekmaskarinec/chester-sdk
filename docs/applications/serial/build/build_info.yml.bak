cmake:
  board:
    name: 'chester'
    path:
     - '/home/marek/dev/hio/chester-sdk/chester/boards/hardwario/chester'
    qualifiers: 'nrf52840'
    revision: ''
  images:
   - name: 'serial'
     source-dir: '/home/marek/dev/hio/chester-sdk/chester/applications/serial'
     type: 'MAIN'
   - name: 'mcuboot'
     source-dir: '/home/marek/dev/hio/chester-sdk/bootloader/mcuboot/boot/zephyr'
     type: 'BOOTLOADER'
  kconfig:
    files:
     - '/home/marek/dev/hio/chester-sdk/chester/applications/serial/build/_sysbuild/empty.conf'
     - '/home/marek/dev/hio/chester-sdk/chester/applications/serial/sysbuild.conf'
    user-files:
     - '/home/marek/dev/hio/chester-sdk/chester/applications/serial/sysbuild.conf'
version: '0.1.0'
west:
  command: '/home/marek/dev/hio/chester-sdk/venv/bin/west build -b chester'
  topdir: '/home/marek/dev/hio/chester-sdk'
  version: '1.5.0'
